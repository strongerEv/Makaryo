# Supabase — ambil dari Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Kunci service role. HANYA dipakai di server action / route handler.
# Jangan pernah diawali NEXT_PUBLIC_ dan jangan di-commit.
SUPABASE_SERVICE_ROLE_KEY=

# URL aplikasi, dipakai untuk tautan reset password
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web Push (VAPID). Buat sekali dengan: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@contoh.com

# Token untuk melindungi route cron (diisi otomatis oleh Vercel bila dipakai)
CRON_SECRET=
