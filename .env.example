# Supabase — ambil dari Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Kunci service role. HANYA dipakai di server action / route handler.
# Jangan pernah diawali NEXT_PUBLIC_ dan jangan di-commit.
SUPABASE_SERVICE_ROLE_KEY=

# URL aplikasi, dipakai untuk tautan reset password
NEXT_PUBLIC_SITE_URL=http://localhost:3000
